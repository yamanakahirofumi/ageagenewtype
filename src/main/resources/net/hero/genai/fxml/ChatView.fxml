<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="400.0" spacing="10.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.chat.ChatController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #858585; -fx-font-size: 11px;" text="AI CHAT" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label fx:id="lblSecurityStatus" onMouseClicked="#handleOpenSecuritySettings" style="-fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 3px 6px; -fx-background-radius: 3px;" text="🛡️ Security: ON" />
                <Button fx:id="btnOllamaConfig" mnemonicParsing="false" onAction="#handleToggleConfig" styleClass="button-secondary" text="Ollama Settings" />
            </children>
        </HBox>

        <!-- Security Warning Banner -->
        <HBox fx:id="securityWarningBanner" alignment="CENTER_LEFT" managed="false" spacing="10.0" style="-fx-background-color: #d32f2f; -fx-padding: 6px 12px; -fx-background-radius: 3px;" visible="false">
            <children>
                <Label style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 11px;" text="⚠️ セキュリティ制限が無効化されています" HBox.hgrow="ALWAYS" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#handleQuickEnableSecurity" style="-fx-background-color: #ffffff; -fx-text-fill: #d32f2f; -fx-font-weight: bold; -fx-padding: 3px 6px; -fx-font-size: 11px; -fx-cursor: hand;" text="今すぐ有効に戻す" />
            </children>
        </HBox>

        <!-- Model Selection -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label style="-fx-text-fill: #cccccc;" text="Model:" />
                <ComboBox fx:id="comboModel" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRefreshModels" onAction="#handleRefreshModels" styleClass="button-secondary" text="Refresh" />
            </children>
        </HBox>

        <!-- Workflow Selection -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label style="-fx-text-fill: #cccccc;" text="Workflow:" />
                <ComboBox fx:id="comboWorkflow" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- Configuration view (expandable or toggled inline) -->
        <VBox fx:id="configContainer" managed="false" visible="false">
            <fx:include fx:id="ollamaConfig" source="OllamaConfig.fxml" />
        </VBox>

        <!-- Workflow Progress/Proposal Panel -->
        <VBox fx:id="workflowPanel" spacing="8.0" style="-fx-background-color: #252526; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-color: #007acc; -fx-border-width: 1px;" visible="false" managed="false">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblWorkflowTitle" style="-fx-font-weight: bold; -fx-text-fill: #007acc; -fx-font-size: 13px;" text="Workflow: ..." />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCancelWorkflow" onAction="#handleCancelWorkflow" styleClass="button-secondary" style="-fx-padding: 3px 8px; -fx-font-size: 11px;" text="Cancel" />
                    </children>
                </HBox>
                <Label fx:id="lblWorkflowDesc" wrapText="true" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;" text="Description..." />

                <!-- Steps Container -->
                <VBox fx:id="workflowStepsContainer" spacing="5.0">
                    <!-- Dynamic workflow steps will be injected here -->
                </VBox>

                <!-- Proposal Actions (for adhoc workflows) -->
                <HBox fx:id="workflowProposalActions" alignment="CENTER_RIGHT" spacing="10.0" visible="false" managed="false" style="-fx-padding: 5px 0 0 0;">
                    <children>
                        <Button fx:id="btnApproveWorkflow" onAction="#handleApproveWorkflow" style="-fx-background-color: #2e7d32; -fx-padding: 4px 10px; -fx-font-size: 11px;" text="Approve &amp; Start" />
                        <Button fx:id="btnRejectWorkflow" onAction="#handleRejectWorkflow" styleClass="button-secondary" style="-fx-padding: 4px 10px; -fx-font-size: 11px;" text="Reject" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Message List (Scrollable Area) -->
        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #1e1e1e;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="messagesBox" spacing="10.0">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Context Badge -->
        <HBox fx:id="contextBadge" alignment="CENTER_LEFT" managed="false" spacing="5.0" style="-fx-background-color: #2d2d2d; -fx-padding: 4px 8px; -fx-background-radius: 3px;" visible="false">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #007acc; -fx-font-size: 11px;" text="Context:" />
                <Label fx:id="lblContextName" style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" text="None" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#handleClearContext" style="-fx-padding: 0 4px; -fx-background-color: transparent; -fx-text-fill: #858585; -fx-cursor: hand;" text="✕" />
            </children>
        </HBox>

        <!-- Input Area -->
        <VBox spacing="5.0">
            <children>
                <TextArea fx:id="txtPrompt" prefHeight="80.0" promptText="Type prompt here... (Ctrl+Enter to send)" wrapText="true" />
                <HBox alignment="TOP_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleClearHistory" styleClass="button-secondary" text="Clear Chat" />
                        <Button fx:id="btnSend" mnemonicParsing="false" onAction="#handleSend" text="Send" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
