<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="250.0" spacing="10.0" style="-fx-background-color: #181818;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.controller.GitController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <!-- Git Repository Uninitialized State -->
        <VBox fx:id="uninitializedBox" alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS" visible="false" managed="false">
            <children>
                <Label style="-fx-text-fill: #858585; -fx-font-size: 11px; -fx-font-weight: bold;" text="GIT REPOSITORY" />
                <Label style="-fx-text-fill: #cccccc; -fx-alignment: center;" text="No git repository detected in workspace." wrapText="true" />
                <Button fx:id="btnInit" mnemonicParsing="false" onAction="#handleInit" text="Initialize Git Repo" />
            </children>
        </VBox>

        <!-- Git Operations Pane (Active State) -->
        <VBox fx:id="operationsBox" spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: #858585; -fx-font-size: 11px; -fx-font-weight: bold;" text="BRANCH:" />
                        <ComboBox fx:id="comboBranches" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleBranchSelection" />
                        <Button fx:id="btnNewBranch" mnemonicParsing="false" onAction="#handleNewBranch" text="+" />
                    </children>
                </HBox>

                <!-- Remote Operations Buttons -->
                <HBox spacing="5.0">
                    <children>
                        <Button fx:id="btnFetch" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleFetch" text="Fetch" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPull" maxWidth="Infinity" mnemonicParsing="false" onAction="#handlePull" text="Pull" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPush" maxWidth="Infinity" mnemonicParsing="false" onAction="#handlePush" text="Push" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Label style="-fx-text-fill: #858585; -fx-font-size: 11px; -fx-font-weight: bold;" text="CHANGES:" />

                <!-- Git Change File List -->
                <ListView fx:id="listChanges" VBox.vgrow="ALWAYS" />

                <!-- Commit Pane -->
                <Label style="-fx-text-fill: #858585; -fx-font-size: 11px; -fx-font-weight: bold;" text="COMMIT MESSAGE:" />
                <TextArea fx:id="txtCommitMessage" prefHeight="80.0" promptText="Commit message (Ctrl+Enter to commit)" wrapText="true" />
                <Button fx:id="btnCommit" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCommit" text="Commit" />
            </children>
        </VBox>

        <!-- Non-blocking Spinner -->
        <HBox fx:id="progressBox" alignment="CENTER" spacing="10.0" visible="false" managed="false">
            <children>
                <ProgressIndicator prefHeight="20.0" prefWidth="20.0" />
                <Label fx:id="lblProgressMessage" style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" text="Working..." />
            </children>
        </HBox>
    </children>
</VBox>
