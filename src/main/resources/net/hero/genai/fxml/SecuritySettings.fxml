<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="700.0" style="-fx-background-color: #1e1e1e;" stylesheets="/net/hero/genai/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.controller.SecuritySettingsController">
    <top>
        <VBox spacing="12.0" style="-fx-background-color: #252526; -fx-border-color: #3c3c3c; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <CheckBox fx:id="chkEnableSecurity" mnemonicParsing="false" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px;" text="エージェント制限を有効にする（推奨）" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #cccccc;" text="自動復帰時間:" />
                                <ComboBox fx:id="comboAutoRestore" prefWidth="150.0" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- Rules List Tab -->
                <Tab text="ルール一覧 (Rules List)">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="tblRules" prefHeight="250.0" prefWidth="680.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRuleCategory" prefWidth="130.0" text="カテゴリ" />
                                        <TableColumn fx:id="colRuleType" prefWidth="100.0" text="種別" />
                                        <TableColumn fx:id="colRulePattern" prefWidth="420.0" text="パターン" />
                                    </columns>
                                </TableView>
                                <!-- Interactive Add Form -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #252526; -fx-padding: 8px; -fx-background-radius: 4px; -fx-border-color: #3c3c3c;">
                                    <children>
                                        <ComboBox fx:id="comboNewCategory" prefWidth="130.0" promptText="カテゴリ" />
                                        <CheckBox fx:id="chkNewIsDeny" style="-fx-text-fill: #ffffff;" text="拒否(!)" />
                                        <TextField fx:id="txtNewPattern" promptText="例: ${WORKSPACE_DIR}/docs/*" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnAddRule" onAction="#handleAddRule" text="追加" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnDeleteRule" onAction="#handleDeleteRule" styleClass="button-secondary" text="選択ルールを削除" />
                                        <Button fx:id="btnSaveRules" onAction="#handleSaveRules" text="変更を保存" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- Direct Edit Tab -->
                <Tab text="直接編集 (.conf)">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TextArea fx:id="txtRawConf" prefHeight="300.0" prefWidth="680.0" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 13px;" VBox.vgrow="ALWAYS" />
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnResetConf" onAction="#handleResetConf" styleClass="button-secondary" text="デフォルトに戻す" />
                                        <Button fx:id="btnSaveRawConf" onAction="#handleSaveRawConf" text="設定を反映して保存" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- Audit Logs Tab -->
                <Tab text="監査履歴 (Audit Logs)">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="tblAuditLogs" prefHeight="300.0" prefWidth="680.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colAuditTimestamp" prefWidth="140.0" text="発生日時" />
                                        <TableColumn fx:id="colAuditCategory" prefWidth="120.0" text="カテゴリ" />
                                        <TableColumn fx:id="colAuditOperation" prefWidth="250.0" text="試行された操作内容" />
                                        <TableColumn fx:id="colAuditResult" prefWidth="110.0" text="判定結果" />
                                        <TableColumn fx:id="colAuditAction" prefWidth="120.0" text="アクション" />
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnClearAuditLogs" onAction="#handleClearAuditLogs" styleClass="button-secondary" text="監査履歴をクリア" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
