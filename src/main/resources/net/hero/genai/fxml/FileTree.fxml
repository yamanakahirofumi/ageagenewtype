<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="250.0" spacing="10.0" style="-fx-background-color: #181818;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.controller.FileTreeController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <Label style="-fx-font-weight: bold; -fx-text-fill: #858585; -fx-font-size: 11px;" text="WORKSPACE" />
        <Button fx:id="btnSelectWorkspace" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSelectWorkspace" text="Open Folder..." />
        <Label fx:id="lblWorkspacePath" style="-fx-text-fill: #858585; -fx-font-size: 11px;" text="No folder opened" wrapText="true" />
        <TreeView fx:id="treeView" VBox.vgrow="ALWAYS" />
    </children>
</VBox>
