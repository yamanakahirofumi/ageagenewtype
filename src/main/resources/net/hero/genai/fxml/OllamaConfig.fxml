<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="380.0" spacing="8.0" style="-fx-background-color: #252526; -fx-border-color: #3c3c3c; -fx-border-width: 1px; -fx-border-radius: 4px; -fx-background-radius: 4px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.ollama.OllamaConfigController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <Label style="-fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Ollama Service Configuration" />

        <VBox spacing="4.0">
            <children>
                <Label style="-fx-text-fill: #cccccc;" text="API Base URL:" />
                <TextField fx:id="txtApiBaseUrl" text="http://localhost:11434" />
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="btnTestConnection" mnemonicParsing="false" onAction="#handleTestConnection" text="Test Connection" />
                <Label fx:id="lblConnectionStatus" style="-fx-font-weight: bold; -fx-text-fill: #858585;" text="Status: Unknown" />
            </children>
        </HBox>
    </children>
</VBox>
