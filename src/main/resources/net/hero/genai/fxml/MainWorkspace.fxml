<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.hero.genai.workspace.MainWorkspaceController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem fx:id="menuSelectWorkspace" mnemonicParsing="false" onAction="#handleSelectWorkspace" text="Select Workspace..." />
                        <MenuItem fx:id="menuClose" mnemonicParsing="false" onAction="#handleClose" text="Close" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem fx:id="menuSave" mnemonicParsing="false" onAction="#handleSave" text="Save File" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="About" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.2, 0.6" prefHeight="160.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <items>
                <!-- Left Pane: TabPane with File Tree and Git Operations -->
                <javafx.scene.control.TabPane fx:id="leftTabPane" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <javafx.scene.control.Tab text="Files">
                            <content>
                                <fx:include fx:id="fileTree" source="FileTree.fxml" />
                            </content>
                        </javafx.scene.control.Tab>
                        <javafx.scene.control.Tab text="Git">
                            <content>
                                <fx:include fx:id="gitPanel" source="GitPanel.fxml" />
                            </content>
                        </javafx.scene.control.Tab>
                    </tabs>
                </javafx.scene.control.TabPane>

                <!-- Center Pane: Editor -->
                <fx:include fx:id="editor" source="Editor.fxml" />

                <!-- Right Pane: Chat -->
                <fx:include fx:id="chatView" source="ChatView.fxml" />
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox id="statusBar" alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="1200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="statusOllamaLabel" text="Ollama: Offline" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="statusModelLabel" text="Model: None" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="statusGitLabel" text="⚠️ No Git Repo" style="-fx-cursor: hand;" onMouseClicked="#handleGitWidgetClick" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="UTF-8" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="statusLineColLabel" text="Line 1, Col 1" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
